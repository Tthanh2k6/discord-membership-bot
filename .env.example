# Copy to .env; Node reads it directly, without dotenv.
# Run: node --env-file=.env src/index.js (npm start tolerates a missing .env).
# All values below are fake demo values. Keep .env out of version control.

# Discord bot token; required for live mode only.
DISCORD_TOKEN=fake-discord-token
# Discord application ID used to register guild slash commands.
DISCORD_APP_ID=111111111111111111
# The single server managed by this bot.
GUILD_ID=222222222222222222
# Unmanaged paid role; the bot role must be above it, with Manage Roles permission.
MEMBER_ROLE_ID=333333333333333333
# Text channel in this guild; the bot needs View Channel and Send Messages.
ORDERS_CHANNEL_ID=444444444444444444
# HTTP listener port (1-65535).
PORT=8787
# SQLite path; parent directories are created automatically.
DB_PATH=./data/bot.db
# Stripe signing secret; leave empty to disable /webhooks/stripe.
# Subscription events need metadata.email or an expanded customer.email.
STRIPE_WEBHOOK_SECRET=
# Whop Standard Webhooks secret (starts with whsec_); leave empty to disable Whop.
# Check mapMembership in src/providers/whop.js against your Whop dashboard payload.
WHOP_WEBHOOK_SECRET=
# Zapier/Make shared HMAC secret; leave empty to disable generic webhooks.
GENERIC_WEBHOOK_SECRET=fake-generic-demo-secret
# Shopify app webhook signing secret; leave empty to disable Shopify.
SHOPIFY_WEBHOOK_SECRET=fake-shopify-demo-secret
# Interval in whole minutes, default 60. Startup also reconciles all links.
RECONCILE_MINUTES=60
# 1 logs actions without Discord login; set 0 for live use. npm run demo forces 1.
DRY_RUN=1
